# Local development: run `vercel env pull .env.local` to get the Neon
# DATABASE_URL and other server env vars from the Vercel project, then
# `vercel dev` to run the Vite app and the api/ functions together.

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Optional social sign-in (also list them in VITE_AUTH_PROVIDERS)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
VITE_AUTH_PROVIDERS="google"

# Cred credits proxy (api/cred)
CRED_API_KEY=""
CRED_CREDIT_TYPE_ID=""

# Avatar uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# OpenRouter (required for VLM analysis)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
