# Local development: run `vercel env pull .env.local` to get the Neon
# DATABASE_URL and other server env vars from the Vercel project, then
# `vercel dev` to run the Vite app and the api/ functions together.
# Apply the schema with `npm run db:migrate` (db/schema.sql).

# Neon Postgres (api/ functions; also used by the self-hosted fleet control plane)
DATABASE_URL=""
# Optional: direct (unpooled) connection, preferred by `npm run db:migrate`
DATABASE_URL_UNPOOLED=""

# Better Auth (api/auth). BETTER_AUTH_URL is the origin you browse to:
# http://localhost:3000 under `vercel dev`. If unset it falls back to the
# Vercel deployment URL, then http://localhost:8080.
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# "Continue with 1Profile" is always enabled; these override the built-in defaults.
# ONEPROFILE_CLIENT_ID=""
# ONEPROFILE_ISSUER=""

# Optional social sign-in. Each provider is enabled on the server only when
# both its ID and secret are set; list the enabled ones in VITE_AUTH_PROVIDERS
# (comma-separated: google,apple) so the login page shows their buttons.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
VITE_AUTH_PROVIDERS=""

# Cred credits (api/cred proxy and /v1 billing). If CRED_API_KEY is unset,
# credits are disabled: /v1 calls are allowed and nothing is charged.
CRED_API_KEY=""
CRED_CREDIT_TYPE_ID=""
# CRED_API_BASE=""        # defaults to Cred's hosted API
# CRED_APP_ORIGIN="https://openeye.sh"
# OPENEYE_CREDITS_DISABLED="true"   # turn billing off (branch previews only; never in production)

# Avatar uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# OpenRouter: enables POST /v1/describe (returns 503 without it)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
# OPENROUTER_VLM_MODEL="qwen/qwen2.5-vl-72b-instruct"

# Force cloud or local dashboard mode instead of detecting it from the hostname
# (openeye.sh and *.vercel.app are cloud). Values: cloud | local
# VITE_DEPLOY_ENV=""
