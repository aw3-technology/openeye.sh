{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__path=:path*"
    },
    {
      "source": "/api/data/:path*",
      "destination": "/api/data?__path=:path*"
    },
    {
      "source": "/api/cred/:path*",
      "destination": "/api/cred?__path=:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/v1?__path=:path*"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/v1.ts": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "{models/yolov8n.onnx,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs}"
    }
  },
  "headers": [
    {
      "source": "/(llms.txt|llms-full.txt|docs/(.*).md)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(dashboard|app.html)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "trailingSlash": false
}
