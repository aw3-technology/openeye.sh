{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "openeye-xi.vercel.app"
        }
      ],
      "destination": "https://openeye.sh/:path*",
      "permanent": true
    },
    {
      "source": "/plans",
      "destination": "/pricing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__path=:path*"
    },
    {
      "source": "/api/data/:path*",
      "destination": "/api/data?__path=:path*"
    },
    {
      "source": "/api/cred/:path*",
      "destination": "/api/cred?__path=:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/v1?__path=:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?__path=:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/mcp",
      "destination": "/.well-known/mcp.json"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/v1.ts": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "{models/yolov8n.onnx,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs}"
    },
    "api/mcp.ts": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "{models/yolov8n.onnx,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs}"
    }
  },
  "headers": [
    {
      "source": "/(llms\\.txt|llms-full\\.txt|SKILL\\.md)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/traffic-advice",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/trafficadvice+json"
        }
      ]
    },
    {
      "source": "/docs/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(dashboard|app.html)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "trailingSlash": false
}
