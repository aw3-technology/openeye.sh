# OpenEye Perception Engine - Environment Variables
# Runtime configs in config/*.json5 reference these as ${VAR}.

# Required for VLM mode (vlm_openai, vlm_gemini)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Gemini API key (for vlm_gemini plugin)
# GOOGLE_API_KEY=your-google-api-key-here

# Anthropic API key (for Claude VLM/LLM)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Nebius Token Factory (for Nebius VLM/LLM)
# NEBIUS_API_KEY=your-nebius-api-key-here

# OpenRouter (for free/paid model routing)
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Tavily (for safety search action)
# TAVILY_API_KEY=your-tavily-api-key-here

# ── Fleet control plane (fleet.create_fleet_app) ──

# Postgres connection string (Neon or any Postgres). Use the website's
# database or your own; apply ../db/schema.sql first (`npm run db:migrate` from
# the repo root, or `psql "$DATABASE_URL" -f db/schema.sql`). Prefer the pooled
# endpoint. Never point tests at production.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_POOL_MAX=10

# Users authenticate with their Better Auth session token:
#   Authorization: Bearer <token>   (raw session token or the signed cookie value)
# User API keys (oe_..., created in the dashboard) work as Bearer or X-API-Key.
# Devices use X-Device-API-Key with the oek_... key returned once at registration.

# Cred credits API (hosted /v1 credit checks). If CRED_API_KEY is unset,
# credits are DISABLED: every request is allowed and nothing is charged.
# CRED_API_KEY=your-cred-server-key
# CRED_API_BASE=   # defaults to Cred's hosted credits API
# CRED_CREDIT_TYPE_ID=
# CRED_APP_ORIGIN=https://openeye.sh

# Comma-separated CORS origins for the control plane. Default:
# http://localhost:5173,http://localhost:3000. The local dashboard (`npm run dev`)
# runs on http://localhost:8080, so add it to manage this control plane from there.
# (The dashboard at openeye.sh uses the website's /api/data, not this server.)
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
