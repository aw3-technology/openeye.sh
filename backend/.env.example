# OpenEye Perception Engine - Environment Variables

# Required for VLM mode (vlm_openai, vlm_gemini)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Gemini API key (for vlm_gemini plugin)
# GOOGLE_API_KEY=your-google-api-key-here

# Anthropic API key (for Claude VLM/LLM)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Nebius Token Factory (for Nebius VLM/LLM)
# NEBIUS_API_KEY=your-nebius-api-key-here

# OpenRouter (for free/paid model routing)
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Tavily (for safety search action)
# TAVILY_API_KEY=your-tavily-api-key-here

# Camera index (default: 0 for built-in webcam)
CAMERA_INDEX=0

# ── Fleet control plane (fleet.create_fleet_app) ──

# Neon Postgres connection string — the same database as the website (schema in
# ../db/schema.sql). Prefer the pooled endpoint. Never point tests at production.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_POOL_MAX=10

# Users authenticate with their Better Auth session token:
#   Authorization: Bearer <token>   (raw session token or the signed cookie value)
# Devices use X-Device-API-Key; hosted /v1 endpoints use oe_ API keys.

# Cred credits API (hosted /v1 credit checks). If CRED_API_KEY is unset,
# credits are DISABLED: every request is allowed and nothing is charged.
# CRED_API_KEY=your-cred-server-key
# CRED_API_BASE=https://eutdgemlrpvnxfkkpvlu.supabase.co/functions/v1
# CRED_CREDIT_TYPE_ID=
# CRED_APP_ORIGIN=https://openeye.sh

# Comma-separated CORS origins for the control plane
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
